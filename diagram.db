Enum situacao_matricula {
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

Table alunos {
  id int [pk, increment]
  nome varchar(255) [not null]
  email varchar(150) [not null, unique]
  data_nascimento date
  telefone char(15)
  data_cadastro datetime [default: `CURRENT_TIMESTAMP`]
}

Table professores {
  id int [pk, increment]
  nome varchar(255) [not null]
  email varchar(150) [not null]
  telefone char(15)
  especialidade varchar(100)
}

Table cursos {
  id int [pk, increment]
  nome varchar(150)
  descricao text
  carga_horaria int [not null, note: 'CHECK (carga_horaria > 0)']
  valor decimal(10, 2) [not null, note: 'CHECK (valor >= 0)']
  professor_id int [not null]
  data_cadastro datetime [default: `CURRENT_TIMESTAMP`]
}

Table matriculas {
  id int [pk, increment]
  aluno_id int [not null]
  curso_id int [not null]
  data_matricula datetime [default: `CURRENT_TIMESTAMP`]
  nota_final decimal(4, 2) [note: 'CHECK (nota_final BETWEEN 0 AND 10 OR nota_final IS NULL)']
  situacao situacao_matricula [not null, default: 'EM_ANDAMENTO']

  indexes {
    (aluno_id, curso_id) [unique, name: 'uk_aluno_curso']
  }
}

// Relacionamentos (Chaves Estrangeiras)
Ref: cursos.professor_id > professores.id
Ref: matriculas.aluno_id > alunos.id
Ref: matriculas.curso_id > cursos.id

